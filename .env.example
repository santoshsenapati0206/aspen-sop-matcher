# Copy to .env and fill in. Never commit .env.

# local | databricks
SOP_BACKEND=local

# local backend: tfidf (no download) | sentence-transformers (needs: pip install -e ".[dense]")
LOCAL_EMBEDDER=tfidf

# databricks backend (Databricks AI Search, formerly Vector Search)
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<personal-access-token>
AI_SEARCH_ENDPOINT=sop-search-endpoint
AI_SEARCH_INDEX=workspace.mlops_sop.sop_chunks_index
AI_SEARCH_QUERY_TYPE=hybrid

# matching
TOP_K_CHUNKS=12
MIN_CONFIDENCE=0.55
